{
  "Wec": {
    "Logging": {
      "MinimumLevel": "Information",
      "LogDirectory": "%LOCALAPPDATA%\\Wec\\logs",
      "RetainedFileCountLimit": 14
    },
    "Database": {
      "DatabasePath": "%LOCALAPPDATA%\\Wec\\wec.db"
    },
    "WebView": {
      "UserDataDirectory": "%LOCALAPPDATA%\\Wec\\webview2"
    },
    "Inventory": {
      "CacheTtl": "00:15:00"
    },
    "Diagnostics": {
      "DnsProbeHostname": "cloudflare.com",
      "ProbeTimeout": "00:00:03",
      "EventLogNames": [ "System" ],
      "EventLogLookback": "1.00:00:00",
      "EventLogMaxEntries": 500,
      "EventLogErrorWarningThreshold": 50,
      "MonitoredServices": [ "Dhcp", "Dnscache", "LanmanWorkstation", "EventLog" ]
    },
    "ActiveDirectory": {
      "PageSize": 500,
      "SearchTimeout": "00:00:30"
    },
    "Frontend": {
      "UseDevServer": false,
      "DevServerUrl": "http://localhost:5173"
    }
  }
}
